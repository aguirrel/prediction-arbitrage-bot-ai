# Kalshi API credentials
KALSHI_API_KEY_ID=your-kalshi-api-key-id
KALSHI_PEM_PATH=./kalshi_private.pem

# Polymarket credentials (Ethereum private key, hex without 0x prefix)
POLYMARKET_PRIVATE_KEY=your-private-key-hex

# Market configuration
#
# Kalshi: a binary event has TWO separate markets, one per outcome.
# Example event: KXNCAAMBGAME-26FEB23LOUUNC
#   Market A (LOU wins): KXNCAAMBGAME-26FEB23LOUUNC-LOU
#   Market B (UNC wins): KXNCAAMBGAME-26FEB23LOUUNC-UNC
KALSHI_MARKET_TICKER_A=KXNCAAMBGAME-26FEB23LOUUNC-LOU
KALSHI_MARKET_TICKER_B=KXNCAAMBGAME-26FEB23LOUUNC-UNC

# Polymarket token IDs for outcome A and B (large decimal numbers).
# IMPORTANT: outcome A here must match the same outcome as KALSHI_MARKET_TICKER_A.
# e.g., if ticker A = LOU wins, then ASSET_ID_A = Polymarket token for LOU wins.
POLYMARKET_ASSET_ID_A=your-token-id-for-outcome-a
POLYMARKET_ASSET_ID_B=your-token-id-for-outcome-b
